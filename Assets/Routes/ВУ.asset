  m_Name: "\u0412\u0423"
  m_EditorClassIdentifier: Assembly-CSharp::MissionSO
  title: "\u041E\u043D \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0441\u043D\u0443\u043B"
  description: "\u0414\u0435\u0432\u0443\u0448\u043A\u0430, \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435...
    \u0422\u0443\u0442 \u043C\u0443\u0436\u0447\u0438\u043D\u0435 \u043D\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435
    \u043F\u043B\u043E\u0445\u043E. \u041D\u0443, \u0442\u043E \u0435\u0441\u0442\u044C
    \u043E\u043D \u0441\u0438\u0434\u0435\u043B, \u043F\u043E\u0442\u043E\u043C \u043A\u0430\u043A-\u0442\u043E
    \u0441\u0442\u0440\u0430\u043D\u043D\u043E \u0437\u0430\u0445\u0440\u0438\u043F\u0435\u043B
    \u0438 \u0441\u043F\u043E\u043B\u0437 \u043D\u0430 \u0430\u0441\u0444\u0430\u043B\u044C\u0442.
    \u041C\u044B \u0434\u0443\u043C\u0430\u043B\u0438, \u043E\u043D \u043F\u044C\u044F\u043D\u044B\u0439,
    \u0441\u043F\u0438\u0442 \u043F\u0440\u043E\u0441\u0442\u043E, \u0430 \u043E\u043D
    \u0441\u0438\u043D\u0435\u0442\u044C \u043D\u0430\u0447\u0430\u043B. \u0418 \u0433\u0440\u0443\u0434\u044C
    \u0432\u0440\u043E\u0434\u0435 \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F.
    \u0415\u0433\u043E \u043F\u043E \u0449\u0435\u043A\u0430\u043C \u0431\u044C\u044E\u0442,
    \u0430 \u043E\u043D \u043D\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442
    \u0432\u043E\u043E\u0431\u0449\u0435. \u0412\u044B \u043F\u0440\u0438\u0435\u0434\u0435\u0442\u0435?"
